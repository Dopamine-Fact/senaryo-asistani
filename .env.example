# Erişim anahtarı (512 onaltılık karakter). Üretmek için: npm run anahtar
# Boş bırakılırsa sunucu 128 karakterlik bir anahtar üretir, veri klasörüne (erisim_anahtari) yazar ve konsola basar.
SENARYO_ERISIM_ANAHTARI=
# PostgreSQL bağlantısı (zorunlu): tüm veriler ve yüklenen .docx dosyaları burada tutulur
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/veritabani
# OpenAI API anahtarı (yapay zekâ incelemesi için; boşsa yalnızca kural listesi çalışır)
OPENAI_API_KEY=
# İsteğe bağlı
# PORT=8765
# HOST=127.0.0.1            # ekip sunucusu için 0.0.0.0
# SENARYO_ASISTANI_DATA=    # varsayılan: ~/.senaryo-asistani
